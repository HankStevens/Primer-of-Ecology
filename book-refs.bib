	journal = {Ecography},
	keywords-plus = {MATCHING HABITAT CHOICE; LOCAL ADAPTATION; GENE FLOW; FUNCTIONAL GENOMICS; DISPERSAL SYNDROMES; DENSITY-DEPENDENCE; RAPID EVOLUTION; POPULATION-SIZE; JOINT EVOLUTION; DAPHNIA-MAGNA},
